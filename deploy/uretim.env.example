# Sunucuda deploy/.env.uretim olarak kopyalanır (.env* gitignore kapsamında, git'e girmez). Gerçek değerleri repoya koymayın.
UYGULAMA_ALAN_ADI=asistanmerkezi.com
API_ALAN_ADI=api.asistanmerkezi.com

# Build anında istemci koduna gömülür; değişirse imaj yeniden build edilir.
NEXT_PUBLIC_SUPABASE_URL=https://api.asistanmerkezi.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase .env içindeki ANON_KEY>

# Yalnız sunucu. Tarayıcıya asla gitmez.
SUPABASE_SERVICE_ROLE_KEY=<supabase .env içindeki SERVICE_ROLE_KEY>
MERKEZ_INTERNAL_SECRET=<yeni üretilen; sızan CRON_SECRET'ın YERİNE, eskisi kullanılmayacak>
